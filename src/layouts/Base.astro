---
import '../styles/global.css';

interface Props {
  titel: string;
  beschreibung?: string;
}

const { titel, beschreibung } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    {beschreibung && <meta name="description" content={beschreibung} />}
  </head>
  <body>
    <slot />
  </body>
</html>
